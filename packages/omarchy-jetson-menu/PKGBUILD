# Maintainer: omarchy-jetson contributors

pkgname=omarchy-jetson-menu
pkgver=0.1.0
pkgrel=32
pkgdesc='Lightweight capability-aware Omarchy menu adapter for Jetson'
arch=('aarch64')
url='https://github.com/Babbletrax/omarchy-jetson'
license=('MIT')
depends=('bash' 'coreutils' 'file' 'findutils' 'foot' 'fuzzel' 'gawk' 'hyprland' 'jq' 'procps-ng' 'systemd' 'util-linux')
optdepends=(
  'btop: activity monitor menu entry'
  'omarchy-jetson-session: lock and idle actions'
  'nvidia-jetson-power: Jetson power status'
  'omarchy-jetson-observability: named thermal, clock and unified-memory status'
  'omarchy-jetson-actions: screenshot actions'
)

source=(
  'omarchy-menu'
  'omarchy-jetson-display'
  'omarchy-jetson-screensaver'
  'omarchy-jetson-appearance'
  'omarchy-jetson-power'
  'omarchy-jetson-bar'
  'theme-dark-waybar.css'
  'theme-light-waybar.css'
  "PROJECT-LICENSE::file://${startdir}/../../LICENSE"
)
