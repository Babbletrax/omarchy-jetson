package() {
  install -Dm755 omarchy-jetson-display "$pkgdir/usr/bin/omarchy-jetson-display"
  install -Dm755 omarchy-jetson-screensaver "$pkgdir/usr/bin/omarchy-jetson-screensaver"
  install -Dm755 omarchy-jetson-appearance "$pkgdir/usr/bin/omarchy-jetson-appearance"
  install -Dm755 omarchy-jetson-power "$pkgdir/usr/bin/omarchy-jetson-power"
  install -Dm755 omarchy-jetson-bar "$pkgdir/usr/bin/omarchy-jetson-bar"
  install -Dm644 theme-dark-waybar.css "$pkgdir/usr/share/omarchy-jetson/themes/dark/waybar.css"
  install -Dm644 theme-light-waybar.css "$pkgdir/usr/share/omarchy-jetson/themes/light/waybar.css"
  install -Dm644 PROJECT-LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
