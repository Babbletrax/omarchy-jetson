# Maintainer: omarchy-jetson contributors

pkgname=ttfx
pkgver=0.3.2
pkgrel=1
pkgdesc='Terminal text effects engine used by the Omarchy screensaver, built for AArch64'
arch=('aarch64')
url='https://github.com/omacom-io/ttfx'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=('!lto')

source=("ttfx-${pkgver}.tar.gz::https://github.com/omacom-io/ttfx/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('d0c0df4867e7f03142fb7f77c66670d0e8da15534239c1a7abfd89f19dfc00f6')

prepare() {
  cd "ttfx-$pkgver"
  # Vendor dependencies up front so the build itself needs no network.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "ttfx-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "ttfx-$pkgver"
  [[ $(file -b target/release/ttfx) == *'ARM aarch64'* ]]
}

package() {
  cd "ttfx-$pkgver"
  install -Dm755 target/release/ttfx "$pkgdir/usr/bin/ttfx"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
