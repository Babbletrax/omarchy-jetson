[Unit]
Description=Voxtype push-to-talk voice-to-text daemon
Documentation=https://voxtype.io
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/voxtype --no-hotkey --no-auto-submit --no-smart-auto-submit --audio-device pipewire daemon
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omarchy-voxtype
MemoryHigh=1G
MemoryMax=2G
TasksMax=256
OOMPolicy=stop

[Install]
WantedBy=graphical-session.target
