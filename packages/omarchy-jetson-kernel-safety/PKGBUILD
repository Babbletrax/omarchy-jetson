# Maintainer: omarchy-jetson contributors

pkgname=omarchy-jetson-kernel-safety
pkgver=0.1.0
pkgrel=1
pkgdesc='Saves the running Jetson kernel to /boot/last-good with a last-good boot entry before kernel updates'
arch=('aarch64')
url='https://github.com/Babbletrax/omarchy-jetson'
license=('MIT')
depends=('bash' 'coreutils' 'diffutils' 'findutils' 'gawk' 'grep' 'pacman' 'sed' 'systemd' 'util-linux')

source=(
  'omarchy-jetson-kernel'
  '10-omarchy-jetson-kernel-backup.hook'
  'omarchy-jetson-kernel-modules.service'
  "PROJECT-LICENSE::file://${startdir}/../../LICENSE"
)
sha256sums=('b2749a38a273d210d7e297bedc0ddca6e287bd2433ea5d908c0be4aa45c388c0'
            'baa50d6a99baf9a183544d43e25c71a9eaf9df54f21bd57457c488bb34375aff'
            '1f86f1bf7446aecbd73961cdd3191bf7dfc5c7986240b620d7888ba99491e1dc'
            '83cfe731d9126f1c55f3663e7c6e51e37267420bd92cfeafcb8ab96d2a9c12a2')

package() {
  install -Dm755 omarchy-jetson-kernel "$pkgdir/usr/bin/omarchy-jetson-kernel"
  install -Dm644 10-omarchy-jetson-kernel-backup.hook \
    "$pkgdir/usr/share/libalpm/hooks/10-omarchy-jetson-kernel-backup.hook"
  install -Dm644 omarchy-jetson-kernel-modules.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-jetson-kernel-modules.service"
  # Statically wanted: the unit's own conditions decide whether it does anything.
  install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../omarchy-jetson-kernel-modules.service \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/omarchy-jetson-kernel-modules.service"
  install -Dm644 PROJECT-LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  test -L "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/omarchy-jetson-kernel-modules.service"
}
