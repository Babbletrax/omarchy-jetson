[Unit]
Description=Omarchy Jetson idle lock
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/swayidle -w idlehint 900 timeout 300 /usr/bin/omarchy-jetson-idle-lock before-sleep /usr/bin/omarchy-system-lock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
