# Maintainer: omarchy-jetson contributors

pkgname=omarchy-jetson-session
pkgver=0.1.0
pkgrel=6
pkgdesc='Login, lock and idle integration for the Omarchy Jetson desktop'
arch=('aarch64')
url='https://github.com/OWNER/omarchy-jetson'
license=('MIT')
depends=('apparmor' 'bash' 'greetd' 'greetd-tuigreet' 'hyprland' 'procps-ng' 'swayidle' 'swaylock' 'systemd' 'util-linux' 'uwsm')
install=omarchy-jetson-session.install

source=(
  'omarchy-jetson-idle-lock'
  'omarchy-jetson-idle.service'
  'greetd-override.conf'
  'bwrap.apparmor'
  "omarchy-greetd.toml::file://${startdir}/../../config/rootfs/greetd-config.toml"
  "PROJECT-LICENSE::file://${startdir}/../../LICENSE"
)
sha256sums=('626160842c3f379751f6be64c8bd676006f69fb88e8c887d944ca34edf22e8f5'
            'da89f0fd872f2b34aa8974edf07321606b710a0ccdd6e3dc634acf7de2fd73ea'
            '7f354afdafefc84861ad2e8b5ffef0f71e6541cc5c41ae6059f8be71e8016ed3'
            '650eb941071eeebb1a179170ee541ab5107b059415670e70a0d0a626274386bd'
            '5e3344640983be7eefafaead07bc958f10ea953f38cf5eaf3712b7c93b3502f6'
            '83cfe731d9126f1c55f3663e7c6e51e37267420bd92cfeafcb8ab96d2a9c12a2')

package() {
  install -Dm755 omarchy-jetson-idle-lock "$pkgdir/usr/bin/omarchy-jetson-idle-lock"
  install -Dm644 omarchy-jetson-idle.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-jetson-idle.service"
  install -Dm644 greetd-override.conf \
    "$pkgdir/usr/lib/systemd/system/greetd.service.d/10-omarchy-jetson.conf"
  # GTK image loaders sandbox with bwrap; the tegra kernel restricts user namespaces.
  install -Dm644 bwrap.apparmor "$pkgdir/etc/apparmor.d/bwrap"
  install -Dm600 omarchy-greetd.toml "$pkgdir/etc/greetd/omarchy-jetson.toml"
  install -Dm644 PROJECT-LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
