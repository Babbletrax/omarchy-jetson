# Maintainer: omarchy-jetson contributors

pkgname=omarchy-jetson-upstream
pkgver=4.0.4
pkgrel=5
pkgdesc='Jetson AGX Orin layer over upstream Omarchy: hardware overrides, managed shell service, PATH ordering'
arch=('aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
# Upstream Omarchy (aarch64 [omarchy] repo) now provides the shell, themes,
# Hyprland defaults and the omarchy-* command set. This package carries only
# what the Jetson needs on top, and retires the packages that used to vendor
# a pinned copy of upstream.
depends=('omarchy' 'omarchy-settings' 'bash' 'foot' 'hyprland' 'jq' 'procps-ng'
         'quickshell' 'systemd' 'util-linux' 'uwsm')
optdepends=('omarchy-jetson-menu: screensaver effect picker (omarchy-jetson-screensaver)'
            'ttfx: terminal effects engine for the screensaver')
provides=('omarchy-jetson-bindings' 'omarchy-jetson-quattro-shell' 'omarchy-jetson-quattro-themes')
conflicts=('omarchy-jetson-bindings' 'omarchy-jetson-quattro-shell' 'omarchy-jetson-quattro-themes')
replaces=('omarchy-jetson-bindings' 'omarchy-jetson-quattro-shell' 'omarchy-jetson-quattro-themes')
install=omarchy-jetson-upstream.install

source=(
  'omarchy-jetson-shell'
  'omarchy-jetson-shell.service'
  'omarchy-jetson-theme-set'
  'default-shell.json'
  'default-menu-extension.jsonc'
  'omarchy-launch-terminal'
  'omarchy-terminal-context'
  'terminal-context.bashrc'
  'omarchy-jetson-reload-hyprland'
  '20-omarchy-jetson'
  'omarchy-jetson-qt612-shell-fix'
  '90-omarchy-jetson-qt612-shell-fix.hook'
  'omarchy-jetson.sh'
  "omarchy-v${pkgver}.tar.gz::https://github.com/omacom/omarchy/archive/refs/tags/v${pkgver}.tar.gz"
  "PROJECT-LICENSE::file://${startdir}/../../LICENSE"
  "omarchy-jetson-SKILL.md::file://${startdir}/../../config/skills/omarchy-jetson/SKILL.md"
)
