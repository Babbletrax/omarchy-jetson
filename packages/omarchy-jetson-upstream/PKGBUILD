package() {
  local upstream="$srcdir/omarchy-$pkgver"
  local overrides="$pkgdir/usr/lib/omarchy-jetson/bin"

  # Hardware overrides, ahead of /usr/bin on PATH (see 20-omarchy-jetson).
  # Work-context terminals need --title/--header-color, which upstream's
  # launcher does not take.
  install -Dm755 omarchy-launch-terminal "$overrides/omarchy-launch-terminal"

  # Upstream hard-codes --random-effect, leaving the ttfx effects unreachable
  # from the menu. Route the choice through omarchy-jetson-screensaver, falling
  # back to random. The guard fails the build if upstream changes the call.
  install -Dm755 "$upstream/bin/omarchy-screensaver" "$overrides/omarchy-screensaver"
  grep -q -- '--random-effect --no-eol --no-restore-cursor' "$overrides/omarchy-screensaver" ||
    { echo 'upstream omarchy-screensaver no longer matches the effect patch' >&2; return 1; }
  sed -i 's#--random-effect --no-eol --no-restore-cursor#--no-eol --no-restore-cursor $(omarchy-jetson-screensaver effect-args 2>/dev/null || echo --random-effect)#' \
    "$overrides/omarchy-screensaver"

  # Managed shell service: seeds config, health-checks and restarts the
  # upstream shell from /usr/share/omarchy.
  install -Dm755 omarchy-jetson-shell "$pkgdir/usr/bin/omarchy-jetson-shell"
  install -Dm644 omarchy-jetson-shell.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-jetson-shell.service"
  install -Dm644 default-shell.json "$pkgdir/usr/share/omarchy-jetson/default-shell.json"
  install -Dm644 default-menu-extension.jsonc \
    "$pkgdir/usr/share/omarchy-jetson/default-menu-extension.jsonc"

  install -Dm755 omarchy-jetson-theme-set "$pkgdir/usr/bin/omarchy-jetson-theme-set"
  install -Dm755 omarchy-terminal-context "$pkgdir/usr/bin/omarchy-terminal-context"
  install -Dm644 terminal-context.bashrc "$pkgdir/usr/share/omarchy-jetson/terminal-context.bashrc"
  install -Dm755 omarchy-jetson-reload-hyprland "$pkgdir/usr/lib/omarchy-jetson/reload-hyprland"

  install -Dm644 20-omarchy-jetson "$pkgdir/usr/share/uwsm/env.d/20-omarchy-jetson"

  # Temporary: upstream's post-4.0.4 Qt 6.12 fix, re-applied after any omarchy
  # install/upgrade only while the installed release lacks it.
  install -Dm755 omarchy-jetson-qt612-shell-fix "$pkgdir/usr/lib/omarchy-jetson/qt612-shell-fix"
  install -Dm644 90-omarchy-jetson-qt612-shell-fix.hook \
    "$pkgdir/usr/share/libalpm/hooks/90-omarchy-jetson-qt612-shell-fix.hook"
  install -Dm644 omarchy-jetson.sh "$pkgdir/etc/profile.d/omarchy-jetson.sh"

  # The Jetson agent skill sits beside upstream's own skills, so upstream's
  # provisioning and omarchy-jetson-shell link it into every agent's skill dir.
  install -Dm644 omarchy-jetson-SKILL.md \
    "$pkgdir/usr/share/omarchy/default/agents/skills/omarchy-jetson/SKILL.md"

  install -Dm644 "$upstream/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/OMARCHY-LICENSE"
  install -Dm644 PROJECT-LICENSE "$pkgdir/usr/share/licenses/$pkgname/PROJECT-LICENSE"
}
